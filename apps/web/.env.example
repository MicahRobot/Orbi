# fixture = replay shared/fixtures, no audio service needed. live = call the service.
VITE_AUDIO_MODE=fixture
# fixture = face summaries from shared/fixtures, no camera needed. live = MediaPipe.
VITE_FACE_MODE=fixture
VITE_AUDIO_URL=http://localhost:8000
# Supabase project → Settings → API Keys. Leave empty to keep everything in this browser's localStorage.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
